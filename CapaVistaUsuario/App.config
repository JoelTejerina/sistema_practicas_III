<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- Valor por defecto: SQL Server Express local. Para usar otro servidor NO edites esto:
             crea conexion.local.txt en la raiz del repo (lo genera Database\Instalar-BaseDeDatos.bat)
             o define la variable de entorno SISTEMA_DB_CONNECTION. -->
        <add name="SistemaDB"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=SistemaPracticas;Integrated Security=True;Connect Timeout=15"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <!-- Envio de mails (recuperacion de contraseña). Dejar SmtpHost vacio para deshabilitarlo.
             Tambien se puede definir con las variables de entorno SISTEMA_SMTP_HOST, _PORT, _USUARIO, _CLAVE, _REMITENTE y _SSL. -->
        <add key="SmtpHost" value="" />
        <add key="SmtpPuerto" value="587" />
        <add key="SmtpSsl" value="true" />
        <add key="SmtpUsuario" value="" />
        <add key="SmtpClave" value="" />
        <add key="SmtpRemitente" value="" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>